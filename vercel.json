{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/submit",
      "dest": "/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminder",
      "schedule": "30 12 * * 1-5"
    },
    {
      "path": "/api/cron-auto-leave",
      "schedule": "55 12 * * 1-5"
    },
    {
      "path": "/api/cron-dispatch",
      "schedule": "58 12 * * *"
    }
  ]
}
